Package: eyeQuality
Title: Preprocessing and Quality Control for Eye-Tracking Data
Version: 0.1.0
Authors@R: c(
    person("Aaron", "Glick", email = "glick094@umn.edu", role = c("aut", "cre"), comment = c(ORCID = "0000-0001-6926-7166")), 
